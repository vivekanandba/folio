{
  "name": "folio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "pages:build": "VITE_BASE=/folio/ npm run build",
    "lint:content": "node --experimental-strip-types tools/lint/cli.ts",
    "preview:offline": "node --experimental-strip-types tools/preview/build.mjs",
    "author": "node --experimental-strip-types tools/authoring/cli.ts",
    "test": "node --experimental-strip-types --test 'tests/*.test.ts'",
    "test:coverage": "node --experimental-strip-types --test --experimental-test-coverage 'tests/*.test.ts'",
    "smoke": "node tools/smoke/run.mjs"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "comment:author": "The AI authoring pipeline (npm run author) needs @anthropic-ai/sdk. Install it on demand \u2014 `npm i -D @anthropic-ai/sdk` \u2014 it is not part of the app build."
}
